# Library AI Agent - Environment Configuration
# Copy this file to .env and fill in your credentials.

# ── Application ─────────────────────────────────────────
DEBUG=false
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET=change-me-to-another-random-secret

# Demo mode: set to "true" to run offline with SQLite + rule-based AI.
DEMO_MODE=true

# ── Google OAuth 2.0 ────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must be: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ── IBM watsonx.ai Studio ────────────────────────────────
# Obtain from: IBM Cloud > watsonx.ai > Project > Manage > API key
USE_WATSONX=true
WATSONX_API_KEY=mGUwf8AMdzCcIkDKR6H_QnijNZlXzsAl2_jChSYiArd4
WATSONX_PROJECT_ID=9cbd1f17-fe18-461e-9125-e2c925d0757c
WATSONX_URL=https://eu-gb.dataplatform.cloud.ibm.com/

# ── IBM Watson Natural Language Understanding ────────────
# Obtain from: IBM Cloud > Watson NLU service > Credentials
USE_WATSON_NLU=true
WATSON_NLU_API_KEY=your-watson-nlu-api-key
WATSON_NLU_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com

# ── IBM Cloud Database (PostgreSQL / Db2) ────────────────
# Leave empty when DEMO_MODE=true (SQLite is used instead)
DB_HOST=your-postgres-host.databases.appdomain.cloud
DB_PORT=32310
DB_NAME=library_db
DB_USER=ibm_cloud_user
DB_PASSWORD=your-db-password

# ── IBM Cloudant (NoSQL student profiles) ────────────────
USE_CLOUDANT=false
CLOUDANT_API_KEY=your-cloudant-api-key
CLOUDANT_URL=https://your-account.cloudantnosqldb.appdomain.cloud

# ── IBM Cloud (general) ──────────────────────────────────
IBM_CLOUD_API_KEY=your-ibm-cloud-api-key
IBM_CLOUD_REGION=us-south
IBM_CLOUD_FUNCTIONS_NAMESPACE=library-agent
